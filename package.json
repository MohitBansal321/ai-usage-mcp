{
  "name": "ai-usage-mcp",
  "version": "0.17.1",
  "mcpName": "io.github.MohitBansal321/ai-usage-mcp",
  "description": "See what Claude Code, Codex CLI and OpenCode actually cost you: tokens, cost, prompt-cache breaks and Pro/Max plan limits, from data already on your machine. Local MCP server and CLI; nothing leaves your machine.",
  "releaseHighlight": {
    "version": "0.17.1",
    "text": "ai-usage report and the other CLI reads now sync first, so they never show weeks-old numbers"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "opencode",
    "codex",
    "token-usage",
    "cost",
    "local-first",
    "claude",
    "anthropic",
    "codex-cli",
    "openai",
    "ai-agents",
    "usage",
    "tokens",
    "llm-cost",
    "prompt-caching",
    "statusline",
    "claude-code-plugin",
    "mcp-server",
    "cli"
  ],
  "license": "MIT",
  "author": "Mohit Bansal",
  "homepage": "https://github.com/MohitBansal321/ai-usage-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohitBansal321/ai-usage-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/MohitBansal321/ai-usage-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "ai-usage-mcp": "dist/mcp/server.js",
    "ai-usage": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bins.mjs",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node dist/cli/index.js verify",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
